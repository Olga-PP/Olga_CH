      "name": "Es Consulta de Saldo"
    },
    {
      "parameters": {
        "jsCode": "// Desenlace 1: consulta pura. Igual se registra en Airtable para\n// dejar traza de la interacción, pero con estado \"consulta\" —\n// no es una solicitud real, no requiere aprobación de nadie.\nconst trigger = $('Execute Workflow Trigger').first().json;\nconst fechaHoraSolicitud = trigger.fecha_hora_solicitud;\nconst solicitudId = 'SOL-' + Date.now();\n\nreturn [{\n  json: {\n    tipo: 'consulta',\n    solicitud_ID: solicitudId,\n    empleado_ID: trigger.empleado_ID,\n    dias_solicitados: 0,\n    dias_disponibles: Number(trigger.dias_disponibles) || 0,\n    estado: 'consulta',\n    fecha_solicitud: fechaHoraSolicitud,\n    token_aprobacion: ''\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        176
      ],
      "id": "519ff25d-3efd-45cb-895a-b6d9ca525cdb",
      "name": "Armar Consulta"
    },
    {
      "parameters": {
        "jsCode": "// Desenlaces 2 y 3: calcula si el saldo alcanza. Empate exacto\n// (disponibles == solicitados) SÍ alcanza. Ninguno de los dos casos\n// lo aprueba o rechaza el sistema — solo el caso \"alcanza\" queda\n// pendiente de un humano; el que no alcanza se registra igual mente\n// (estado: rechazado automáticamente) pero sin pasar por aprobación.\nconst trigger = $('Execute Workflow Trigger').first().json;\nconst fechaHoraSolicitud = trigger.fecha_hora_solicitud;\nconst diasSolicitados = Number(trigger.dias_solicitados) || 0;\nconst diasDisponibles = Number(trigger.dias_disponibles) || 0;\nconst diferencia = diasDisponibles - diasSolicitados;\nconst alcanza = diferencia >= 0;\n\nconst solicitudId = 'SOL-' + Date.now();\nconst tokenAprobacion = alcanza\n  ? Math.random().toString(36).substring(2, 10) + Date.now().toString(36)\n  : '';\n\nreturn [{\n  json: {\n    tipo: alcanza ? 'solicitud_pendiente' : 'rechazo_automatico',\n    solicitud_ID: solicitudId,\n    empleado_ID: trigger.empleado_ID,\n    dias_solicitados: diasSolicitados,\n    dias_disponibles: diasDisponibles,\n    excede_saldo: !alcanza,\n    estado: alcanza ? 'pendiente' : 'rechazado_automaticamente',\n    token_aprobacion: tokenAprobacion,\n    fecha_solicitud: fechaHoraSolicitud\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        480
      ],
      "id": "3f44b867-b400-40fd-8da8-e4a403d24508",
