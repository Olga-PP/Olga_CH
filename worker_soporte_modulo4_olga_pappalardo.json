      "parameters": {
        "jsCode": "// Tarea atómica: validar que haya una descripción real antes de\n// crear el ticket (evita registros vacíos en Airtable).\nconst trigger = $('Execute Workflow Trigger').first().json;\nconst fechaHoraSolicitud = trigger.fecha_hora_solicitud;\nconst descripcion = (trigger.descripcion_ticket || '').trim();\n\nif (!descripcion) {\n  return [{ json: { valido: false, motivo: 'descripcion_vacia' } }];\n}\n\nconst ticketId = 'TCK-' + Date.now();\n\nreturn [{\n  json: {\n    valido: true,\n    ticket_ID: ticketId,\n    empleado_ID: trigger.empleado_ID,\n    descripcion,\n    estado: 'abierto',\n    fecha_creacion: fechaHoraSolicitud\n  }\n}];"
      },
